# Step 1 - Sign in & vault provider at https://kimss.ai/app/signup
# Step 2 - Mint Gateway key at https://kimss.ai/app/keys
KIMSS_API_KEY=kimss_xxxxxxxxxxxxxxxxxxxxxxxx
# Alias still accepted:
# KIMSS_WORKSPACE_KEY=kimss_xxxxxxxxxxxxxxxxxxxxxxxx

# Step 3 - Stable agent slug for X-Kimss-Agent-Id (JIT row on /app/agents after first call)
KIMSS_AGENT_ID=enterprise_db_auditor
KIMSS_AGENT_NAME=Database Auditor Agent

# Vaulted logical model id
KIMSS_MODEL=custom:kimss-gpt-5-3-chat

# Gateway OpenAI-compat URL (default)
KIMSS_GATEWAY_URL=https://api.kimss.ai/v1
